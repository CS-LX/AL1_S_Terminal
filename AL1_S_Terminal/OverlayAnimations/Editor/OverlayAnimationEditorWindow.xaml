<Window x:Class="AL1_S_Terminal.OverlayAnimations.Editor.OverlayAnimationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Overlay 动画编辑器"
        Width="960"
        Height="640"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button x:Name="OpenButton" Content="打开" Padding="8,2" Margin="0,0,4,0" Click="OpenButton_Click" />
            <Button x:Name="SaveButton" Content="保存" Padding="8,2" Margin="0,0,4,0" Click="SaveButton_Click" />
            <Button x:Name="SaveAsButton" Content="另存为" Padding="8,2" Margin="0,0,4,0" Click="SaveAsButton_Click" />
            <Separator />
            <Button x:Name="PlayButton" Content="播放" Padding="8,2" Margin="0,0,4,0" Click="PlayButton_Click" />
            <Button x:Name="PauseButton" Content="暂停" Padding="8,2" Margin="0,0,4,0" Click="PauseButton_Click" />
            <Button x:Name="RestartButton" Content="重播" Padding="8,2" Margin="0,0,4,0" Click="RestartButton_Click" />
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="320" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="StructureTree"
                      Grid.Column="0"
                      Margin="8" />

            <DataGrid x:Name="KeyframesGrid"
                      Grid.Column="1"
                      Margin="8"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="t (ms)" Binding="{Binding T}" Width="70" />
                    <DataGridTextColumn Header="x" Binding="{Binding X}" Width="60" />
                    <DataGridTextColumn Header="y" Binding="{Binding Y}" Width="60" />
                    <DataGridTextColumn Header="opacity" Binding="{Binding Opacity}" Width="80" />
                    <DataGridTextColumn Header="scale" Binding="{Binding Scale}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Margin="8" BorderBrush="#CCC" BorderThickness="1" Padding="4">
                <wfi:WindowsFormsHost x:Name="PreviewHost" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
