<Window x:Class="AL1_S_Terminal.OverlayAnimations.Editor.OverlayAnimationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AL1_S_Terminal.OverlayAnimations.Editor"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Overlay 动画编辑器"
        Width="1000"
        Height="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Editor.BgBrush}"
        Foreground="{StaticResource Editor.FgBrush}">
    <Window.Resources>
        <Color x:Key="Editor.Bg">#1E1E1E</Color>
        <Color x:Key="Editor.Panel">#252526</Color>
        <Color x:Key="Editor.PanelDeep">#1E1E1E</Color>
        <Color x:Key="Editor.Border">#3F3F46</Color>
        <Color x:Key="Editor.Fg">#D4D4D4</Color>
        <Color x:Key="Editor.FgMuted">#858585</Color>
        <Color x:Key="Editor.InputBg">#333337</Color>
        <Color x:Key="Editor.ToolBarBg">#2D2D30</Color>
        <Color x:Key="Editor.ButtonBg">#3E3E42</Color>
        <Color x:Key="Editor.ButtonHover">#505050</Color>
        <Color x:Key="Editor.Accent">#007ACC</Color>
        <Color x:Key="Editor.SelectionBg">#094771</Color>
        <Color x:Key="Editor.GridRowAlt">#2A2A2D</Color>

        <SolidColorBrush x:Key="Editor.BgBrush" Color="{StaticResource Editor.Bg}" />
        <SolidColorBrush x:Key="Editor.PanelBrush" Color="{StaticResource Editor.Panel}" />
        <SolidColorBrush x:Key="Editor.PanelDeepBrush" Color="{StaticResource Editor.PanelDeep}" />
        <SolidColorBrush x:Key="Editor.BorderBrush" Color="{StaticResource Editor.Border}" />
        <SolidColorBrush x:Key="Editor.FgBrush" Color="{StaticResource Editor.Fg}" />
        <SolidColorBrush x:Key="Editor.FgMutedBrush" Color="{StaticResource Editor.FgMuted}" />
        <SolidColorBrush x:Key="Editor.InputBgBrush" Color="{StaticResource Editor.InputBg}" />
        <SolidColorBrush x:Key="Editor.ToolBarBgBrush" Color="{StaticResource Editor.ToolBarBg}" />
        <SolidColorBrush x:Key="Editor.ButtonBgBrush" Color="{StaticResource Editor.ButtonBg}" />
        <SolidColorBrush x:Key="Editor.ButtonHoverBrush" Color="{StaticResource Editor.ButtonHover}" />
        <SolidColorBrush x:Key="Editor.AccentBrush" Color="{StaticResource Editor.Accent}" />
        <SolidColorBrush x:Key="Editor.SelectionBgBrush" Color="{StaticResource Editor.SelectionBg}" />
        <SolidColorBrush x:Key="Editor.GridRowAltBrush" Color="{StaticResource Editor.GridRowAlt}" />

        <Style x:Key="EditorTextBlockLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Editor.FgBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="EditorTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Editor.InputBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Editor.FgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Editor.BorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource Editor.FgBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Editor.SelectionBgBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style x:Key="EditorComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Editor.InputBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Editor.FgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Editor.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style x:Key="EditorToolBarButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Editor.ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Editor.FgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Editor.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Editor.ButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorDangerButton" TargetType="Button" BasedOn="{StaticResource EditorToolBarButton}">
            <Setter Property="BorderBrush" Value="#8B3A3A" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A2D2D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolBar">
            <Setter Property="Background" Value="{StaticResource Editor.ToolBarBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Editor.FgBrush}" />
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource Editor.BorderBrush}" />
            <Setter Property="Margin" Value="6,4" />
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Editor.FgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Editor.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource Editor.FgBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Editor.SelectionBgBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3F5A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Editor.PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Editor.FgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Editor.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{StaticResource Editor.PanelBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Editor.GridRowAltBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Editor.BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Editor.BorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Editor.ToolBarBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Editor.FgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Editor.BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Editor.SelectionBgBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="{StaticResource Editor.BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Editor.FgBrush}" />
            <Setter Property="Padding" Value="4,2" />
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Editor.SelectionBg}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Editor.Fg}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3A3D41" />
            </Style.Resources>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource Editor.BgBrush}">
        <ToolBar DockPanel.Dock="Top" Padding="4,6">
            <Button x:Name="NewButton" Content="新建" Style="{StaticResource EditorToolBarButton}" Click="NewButton_Click" />
            <Button x:Name="ImportButton" Content="导入" Style="{StaticResource EditorToolBarButton}" Click="ImportButton_Click" />
            <Button x:Name="ExportButton" Content="导出" Style="{StaticResource EditorToolBarButton}" Click="ExportButton_Click" />
            <Button x:Name="ExportAsButton" Content="导出为" Style="{StaticResource EditorToolBarButton}" Click="ExportAsButton_Click" />
            <Separator />
            <Button x:Name="PlayButton" Content="播放" Style="{StaticResource EditorToolBarButton}" Click="PlayButton_Click" />
            <Button x:Name="PauseButton" Content="暂停" Style="{StaticResource EditorToolBarButton}" Click="PauseButton_Click" />
            <Button x:Name="RestartButton" Content="重播" Style="{StaticResource EditorToolBarButton}" Click="RestartButton_Click" />
        </ToolBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" MinHeight="120" MaxHeight="420" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="200" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="340" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="8,8,4,8"
                        Background="{StaticResource Editor.PanelBrush}"
                        BorderBrush="{StaticResource Editor.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="叠加层尺寸（像素）" Style="{StaticResource EditorTextBlockLabel}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBox x:Name="OverlayWidthBox"
                                         Style="{StaticResource EditorTextBox}"
                                         Width="72"
                                         VerticalContentAlignment="Center"
                                         TextChanged="OverlaySizeBox_TextChanged" />
                                <TextBlock Text="×"
                                           Foreground="{StaticResource Editor.FgMutedBrush}"
                                           Margin="6,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="OverlayHeightBox"
                                         Style="{StaticResource EditorTextBox}"
                                         Width="72"
                                         VerticalContentAlignment="Center"
                                         TextChanged="OverlaySizeBox_TextChanged" />
                            </StackPanel>
                            <TextBlock Text="默认状态" Margin="0,10,0,0" Style="{StaticResource EditorTextBlockLabel}" />
                            <ComboBox x:Name="DefaultStateCombo"
                                      Style="{StaticResource EditorComboBox}"
                                      Margin="0,4,0,0"
                                      SelectionChanged="DefaultStateCombo_OnSelectionChanged" />

                            <TextBlock Text="结构（右键菜单编辑）" Margin="0,12,0,4" Style="{StaticResource EditorTextBlockLabel}" />
                        </StackPanel>

                        <TreeView x:Name="StructureTree"
                                  Grid.Row="1"
                                  ContextMenuOpening="StructureTree_OnContextMenuOpening"
                                  SelectedItemChanged="StructureTree_OnSelectedItemChanged" />
                    </Grid>
                </Border>

                <DataGrid x:Name="KeyframesGrid"
                          Grid.Column="1"
                          Margin="4,8,4,8"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          CanUserDeleteRows="True"
                          IsReadOnly="False"
                          CellEditEnding="KeyframesGrid_OnCellEditEnding"
                          RowEditEnding="KeyframesGrid_OnRowEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="t (ms)" Binding="{Binding T}" Width="70" />
                        <DataGridTextColumn Header="x" Binding="{Binding X}" Width="60" />
                        <DataGridTextColumn Header="y" Binding="{Binding Y}" Width="60" />
                        <DataGridTextColumn Header="opacity" Binding="{Binding Opacity}" Width="80" />
                        <DataGridTextColumn Header="scale" Binding="{Binding Scale}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="2"
                        Margin="4,8,8,8"
                        Background="{StaticResource Editor.PanelDeepBrush}"
                        BorderBrush="{StaticResource Editor.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="4">
                    <wfi:WindowsFormsHost x:Name="PreviewHost" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="{StaticResource Editor.BorderBrush}"
                          ResizeDirection="Rows"
                          ShowsPreview="False" />

            <Border Grid.Row="2"
                    Background="{StaticResource Editor.PanelBrush}"
                    BorderBrush="{StaticResource Editor.BorderBrush}"
                    BorderThickness="0,1,0,0">
                <DockPanel Margin="0,4,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="8,0,8,6">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Assets"
                                   Foreground="{StaticResource Editor.FgBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AssetsImportImageButton"
                                    Content="导入图片"
                                    Style="{StaticResource EditorToolBarButton}"
                                    Click="AssetsImportImageButton_Click" />
                            <Button x:Name="AssetsApplyToLayerButton"
                                    Content="应用到当前图层"
                                    Style="{StaticResource EditorToolBarButton}"
                                    Click="AssetsApplyToLayerButton_Click" />
                            <Button x:Name="AssetsDeleteResourceButton"
                                    Content="删除资源"
                                    Style="{StaticResource EditorDangerButton}"
                                    Margin="8,0,0,0"
                                    Click="AssetsDeleteResourceButton_Click" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="AssetsHintText"
                               DockPanel.Dock="Bottom"
                               Margin="8,4,8,6"
                               Foreground="{StaticResource Editor.FgMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="双击资源可将该图块键应用到左侧树中选中的图层；或选中图层与资源后点「应用到当前图层」。「删除资源」会移除登记项与磁盘文件（有图层引用时不可删）。" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,0">
                        <ListBox x:Name="AssetsListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource Editor.FgBrush}"
                                 SelectionMode="Single"
                                 SelectionChanged="AssetsListBox_OnSelectionChanged"
                                 MouseDoubleClick="AssetsListBox_OnMouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="Margin" Value="0,0,8,8" />
                                    <Setter Property="Background" Value="{StaticResource Editor.ToolBarBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Editor.BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Editor.SelectionBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Editor.AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Editor.AccentBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:EditorAssetItem}">
                                    <StackPanel Width="100">
                                        <Border Width="88"
                                                Height="88"
                                                Background="{StaticResource Editor.PanelDeepBrush}"
                                                HorizontalAlignment="Center"
                                                CornerRadius="2">
                                            <Image Source="{Binding Preview}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Width="80"
                                                   Height="80" />
                                        </Border>
                                        <TextBlock Text="{Binding Key}"
                                                   Foreground="{StaticResource Editor.FgBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   ToolTip="{Binding RelativePath}" />
                                        <TextBlock Text="{Binding RelativePath}"
                                                   Foreground="{StaticResource Editor.FgMutedBrush}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextAlignment="Center"
                                                   ToolTip="{Binding RelativePath}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
