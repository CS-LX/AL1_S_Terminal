<Window x:Class="AL1_S_Terminal.OverlayAnimations.Editor.OverlayAnimationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Overlay 动画编辑器"
        Width="1000"
        Height="680"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button x:Name="NewButton" Content="新建" Padding="8,2" Margin="0,0,4,0" Click="NewButton_Click" />
            <Button x:Name="ImportButton" Content="导入" Padding="8,2" Margin="0,0,4,0" Click="ImportButton_Click" />
            <Button x:Name="ExportButton" Content="导出" Padding="8,2" Margin="0,0,4,0" Click="ExportButton_Click" />
            <Button x:Name="ExportAsButton" Content="导出为" Padding="8,2" Margin="0,0,4,0" Click="ExportAsButton_Click" />
            <Separator />
            <Button x:Name="PlayButton" Content="播放" Padding="8,2" Margin="0,0,4,0" Click="PlayButton_Click" />
            <Button x:Name="PauseButton" Content="暂停" Padding="8,2" Margin="0,0,4,0" Click="PauseButton_Click" />
            <Button x:Name="RestartButton" Content="重播" Padding="8,2" Margin="0,0,4,0" Click="RestartButton_Click" />
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="340" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="8,8,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="叠加层尺寸（像素）" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox x:Name="OverlayWidthBox" Width="72" VerticalContentAlignment="Center" TextChanged="OverlaySizeBox_TextChanged" />
                        <TextBlock Text="×" Margin="6,0" VerticalAlignment="Center" />
                        <TextBox x:Name="OverlayHeightBox" Width="72" VerticalContentAlignment="Center" TextChanged="OverlaySizeBox_TextChanged" />
                    </StackPanel>
                    <TextBlock Text="默认状态" Margin="0,10,0,0" FontWeight="SemiBold" />
                    <ComboBox x:Name="DefaultStateCombo" Margin="0,4,0,0" SelectionChanged="DefaultStateCombo_OnSelectionChanged" />

                    <TextBlock Text="结构（右键菜单编辑）" Margin="0,12,0,4" FontWeight="SemiBold" />
                </StackPanel>

                <TreeView x:Name="StructureTree"
                          Grid.Row="1"
                          ContextMenuOpening="StructureTree_OnContextMenuOpening"
                          SelectedItemChanged="StructureTree_OnSelectedItemChanged" />
            </Grid>

            <DataGrid x:Name="KeyframesGrid"
                      Grid.Column="1"
                      Margin="4,8,4,8"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      CanUserDeleteRows="True"
                      IsReadOnly="False"
                      CellEditEnding="KeyframesGrid_OnCellEditEnding"
                      RowEditEnding="KeyframesGrid_OnRowEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="t (ms)" Binding="{Binding T}" Width="70" />
                    <DataGridTextColumn Header="x" Binding="{Binding X}" Width="60" />
                    <DataGridTextColumn Header="y" Binding="{Binding Y}" Width="60" />
                    <DataGridTextColumn Header="opacity" Binding="{Binding Opacity}" Width="80" />
                    <DataGridTextColumn Header="scale" Binding="{Binding Scale}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Margin="4,8,8,8" BorderBrush="#CCC" BorderThickness="1" Padding="4">
                <wfi:WindowsFormsHost x:Name="PreviewHost" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
