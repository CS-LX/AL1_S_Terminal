<Window x:Class="AL1_S_Terminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AL1_S_Terminal"
        Width="200"
        Height="200"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Visibility="Hidden"
        WindowStartupLocation="Manual">
    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Assets/window_bg.png"
                    Stretch="UniformToFill"
                    AlignmentX="Left"
                    AlignmentY="Bottom" />
    </Window.Background>
    <Grid />
</Window>
