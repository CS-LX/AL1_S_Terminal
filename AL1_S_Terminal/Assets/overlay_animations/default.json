{
  "version": 1,
  "defaultState": "Idle",
  "images": {
    "spark": "Assets/overlay_animations/images/spark.png",
    "ring": "Assets/overlay_animations/images/ring.png",
    "logo": "Assets/overlay_animations/images/logo.png"
  },
  "states": {
    "Idle": {
      "clip": "idle",
      "loop": true
    },
    "Pulse": {
      "clip": "pulse",
      "loop": true
    }
  },
  "clips": {
    "idle": {
      "durationMs": 4000,
      "layers": {
        "logoLayer": {
          "imageKey": "logo",
          "frames": [
            { "t": 0, "x": 0, "y": 0, "opacity": 1, "scale": 1 },
            { "t": 2000, "x": 4, "y": 2, "opacity": 0.92, "scale": 1.02 },
            { "t": 4000, "x": 0, "y": 0, "opacity": 1, "scale": 1 }
          ]
        },
        "sparkLayer": {
          "imageKey": "spark",
          "frames": [
            { "t": 0, "x": 24, "y": 8, "opacity": 0.4, "scale": 0.9 },
            { "t": 2000, "x": 28, "y": 10, "opacity": 0.7, "scale": 1 },
            { "t": 4000, "x": 24, "y": 8, "opacity": 0.4, "scale": 0.9 }
          ]
        }
      }
    },
    "pulse": {
      "durationMs": 1200,
      "layers": {
        "ringLayer": {
          "imageKey": "ring",
          "frames": [
            { "t": 0, "x": 0, "y": 0, "opacity": 0.35, "scale": 0.85 },
            { "t": 600, "x": 0, "y": 0, "opacity": 0.85, "scale": 1.15 },
            { "t": 1200, "x": 0, "y": 0, "opacity": 0.35, "scale": 0.85 }
          ]
        }
      }
    }
  }
}
